# ──────────────────────────────────────────────────────────────
# Jeevan Setu Telemetry Simulator – Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in appropriate values.
# NEVER commit real secrets to version control.
# ──────────────────────────────────────────────────────────────

# Backend API URL (where the Flask backend is running)
# For local PC testing:
SIMULATOR_API_BASE_URL=http://127.0.0.1:5000
# For LAN / mobile hotspot testing (use your actual LAN IP):
# SIMULATOR_API_BASE_URL=http://172.20.10.2:5000

# Authentication (optional — leave empty for local dev fallback)
# If set, the simulator will obtain a JWT via POST /api/v1/auth/login
SIMULATOR_AUTH_USERNAME=
SIMULATOR_AUTH_PASSWORD=

# Telemetry interval in seconds (minimum: 1)
SIMULATOR_INTERVAL_SECONDS=5

# HTTP request timeout
SIMULATOR_TIMEOUT_SECONDS=10

# Maximum retry attempts for failed submissions
SIMULATOR_MAX_RETRIES=2

# Backoff delay between retries (seconds)
SIMULATOR_RETRY_BACKOFF=2.0

# Simulated device ID prefix
SIMULATOR_DEVICE_PREFIX=SIM-ICU

# Mode label
SIMULATOR_MODE=development
